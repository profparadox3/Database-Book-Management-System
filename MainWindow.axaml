<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="650"
        x:Class="BookGuiSystem.MainWindow"
        Title="Enterprise Book Inventory System" 
        Width="1050" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

	<!-- Modern Inter Font and Sleek Grid Layout -->
	<Grid RowDefinitions="Auto, *" Margin="24">
		
		<!-- HEADER BAR -->
		<Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="20,16" Margin="0,0,0,20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="15" Opacity="0.25" OffsetX="0" OffsetY="4"/>
			</Border.Effect>
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock Text="📚" FontSize="24" VerticalAlignment="Center"/>
						<TextBlock Text="Book Management Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
					</StackPanel>
					<TextBlock Text="Database Applications - University Lab 11 &amp; 12" FontSize="12" Foreground="#94A3B8" Margin="34,4,0,0"/>
				</StackPanel>
				<Border Grid.Column="1" Background="#0F172A" CornerRadius="20" Padding="16,8" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center"/>
						<TextBlock Name="lblStatus" Text="System Status: Connected to local MySQL" FontSize="12" FontWeight="Medium" Foreground="#F8FAFC" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- MAIN CONTENT PANEL -->
		<Grid Grid.Row="1" ColumnDefinitions="360, *">
			
			<!-- LEFT SIDE: FLOATING INPUT CARD -->
			<Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="24" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
				<Border.Effect>
					<DropShadowEffect BlurRadius="20" Opacity="0.3" OffsetX="0" OffsetY="8"/>
				</Border.Effect>
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="16">
						<TextBlock Text="Manage Book Details" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>

						<!-- Book ID (Read Only for tracking selection) -->
						<StackPanel Spacing="6">
							<TextBlock Text="Book ID (Auto-Generated)" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
							<TextBox Name="txtBookId" IsReadOnly="True" Watermark="Auto" Height="38" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="#334155" Foreground="#64748B" CornerRadius="6" Padding="10,0"/>
						</StackPanel>

						<!-- Book Title -->
						<StackPanel Spacing="6">
							<TextBlock Text="Book Title" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
							<TextBox Name="txtBookName" Watermark="Enter book title..." Height="38" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" CornerRadius="6" Padding="10,0"/>
						</StackPanel>

						<!-- Author -->
						<StackPanel Spacing="6">
							<TextBlock Text="Author Name" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
							<TextBox Name="txtAuthor" Watermark="Enter author's name..." Height="38" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" CornerRadius="6" Padding="10,0"/>
						</StackPanel>

						<!-- Price -->
						<StackPanel Spacing="6">
							<TextBlock Text="Price ($)" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
							<TextBox Name="txtPrice" Watermark="e.g. 19.99" Height="38" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" CornerRadius="6" Padding="10,0"/>
						</StackPanel>

						<!-- Genre -->
						<StackPanel Spacing="6">
							<TextBlock Text="Genre" FontSize="12" FontWeight="Medium" Foreground="#94A3B8"/>
							<TextBox Name="txtGenre" Watermark="e.g. Fiction / Sci-Fi" Height="38" VerticalContentAlignment="Center" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" CornerRadius="6" Padding="10,0"/>
						</StackPanel>

						<!-- CONTROL BUTTONS GRID -->
						<Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,12,0,0">
							<!-- Save Button -->
							<Button Name="btnSave" Grid.Row="0" Grid.Column="0" Content="Save / Insert" Background="#10B981" Foreground="White" Height="40" Margin="0,0,6,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" CornerRadius="6"/>
							
							<!-- Update Button -->
							<Button Name="btnEdit" Grid.Row="0" Grid.Column="1" Content="Update Edit" Background="#F59E0B" Foreground="White" Height="40" Margin="6,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" CornerRadius="6"/>
							
							<!-- Delete Button -->
							<Button Name="btnDelete" Grid.Row="1" Grid.Column="0" Content="Delete Book" Background="#EF4444" Foreground="White" Height="40" Margin="0,0,6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" CornerRadius="6"/>
							
							<!-- Refresh Button -->
							<Button Name="btnDisplay" Grid.Row="1" Grid.Column="1" Content="Refresh View" Background="#3B82F6" Foreground="White" Height="40" Margin="6,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" CornerRadius="6"/>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- RIGHT SIDE: PROFESSIONAL DATAGRID INVENTORY -->
			<Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20" Margin="12,0,0,0" BorderBrush="#334155" BorderThickness="1">
				<Border.Effect>
					<DropShadowEffect BlurRadius="20" Opacity="0.3" OffsetX="0" OffsetY="8"/>
				</Border.Effect>
				<Grid RowDefinitions="Auto, *">
					<TextBlock Grid.Row="0" Text="Stored Books Inventory" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="4,0,0,16"/>

					<!-- styled DataGrid -->
					<DataGrid Grid.Row="1" Name="dgBooks" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" SelectionMode="Single">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Book ID" Binding="{Binding Id}" Width="90"/>
							<DataGridTextColumn Header="Book Title" Binding="{Binding Title}" Width="2.5*"/>
							<DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="2*"/>
							<DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="1.5*"/>
							<DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="2*"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
